{
  "rewrites": [
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/favicon.ico", "destination": "/assets/logo-robot.ico" },
    { "source": "/api/(.*)", "destination": "/api/index.py" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300
    }
  }
}
